# Optional image: the established GICP/Nav2 image stays unchanged.
ARG BASE_IMAGE=go2-3d:edu
FROM ${BASE_IMAGE}
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -o APT::Update::Error-Mode=any && apt-get install -y --no-install-recommends \
    ros-humble-rtabmap-slam ros-humble-rtabmap-msgs ros-humble-rosbag2 python3-opencv \
    && rm -rf /var/lib/apt/lists/*
