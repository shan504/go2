# syntax=docker/dockerfile:1
# Optional image. Building it never updates or restarts go2-3d:edu containers.
ARG BASE_IMAGE=go2-3d:edu
FROM ${BASE_IMAGE}
USER root
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -o APT::Update::Error-Mode=any && apt-get install -y --no-install-recommends \
    build-essential git patch python3-dev python3-venv libgl1 libgomp1 \
    ros-humble-rosbag2 ros-humble-rosbag2-storage-default-plugins \
    && rm -rf /var/lib/apt/lists/*
COPY requirements-kiss.lock /opt/kiss-build/requirements-kiss.lock
COPY go2_3d/setup_kiss_env.sh go2_3d/check_kiss_env.py /opt/kiss-build/go2_3d/
# In managed cloud builds pass --secret id=proxy_ca,src=/etc/ssl/certs/ca-certificates.crt.
# On ordinary hosts omit the secret; normal system CA trust remains enabled.
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then \
      export SSL_CERT_FILE=/run/secrets/proxy_ca PIP_CERT=/run/secrets/proxy_ca \
        REQUESTS_CA_BUNDLE=/run/secrets/proxy_ca GIT_SSL_CAINFO=/run/secrets/proxy_ca \
        CMAKE_TLS_CAINFO=/run/secrets/proxy_ca; \
    fi; \
    KISS_PYTHON=/usr/bin/python3 KISS_VENV=/opt/kiss-venv KISS_DEPS=/opt/kiss-deps \
      bash /opt/kiss-build/go2_3d/setup_kiss_env.sh
ENV OMP_NUM_THREADS=2 OPENBLAS_NUM_THREADS=1
WORKDIR /opt/go2_project
